{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm install --legacy-peer-deps",
  "buildCommand": "cd frontend && CI=false npm run build",
  "outputDirectory": "frontend/build",
  "framework": null,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.bailadembow.com"
        }
      ],
      "destination": "https://bailadembow.com/$1",
      "permanent": true
    },
    {
      "source": "/agenda/ijland-amsterdam-noord",
      "destination": "/halloween",
      "permanent": true
    },
    {
      "source": "/agenda/:path*",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/tickets",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/events/groningen-all-white-22-august-2026",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/events/summer-of-love-29-august-2026",
      "destination": "/events",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
