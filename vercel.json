{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --omit=dev --no-audit --no-fund && cd frontend && npm install --legacy-peer-deps",
  "buildCommand": "cd frontend && CI=false npm run build",
  "outputDirectory": "frontend/build",
  "framework": null,
  "redirects": [
    {
      "source": "/halloween-2027",
      "destination": "/halloween/2027",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.bailadembow.com"
        }
      ],
      "destination": "https://bailadembow.com/$1",
      "permanent": true
    },
    {
      "source": "/agenda/ijland-amsterdam-noord",
      "destination": "/halloween",
      "permanent": true
    },
    {
      "source": "/agenda/:path*",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/tickets",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/events/groningen-all-white-22-august-2026",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/events/summer-of-love-29-august-2026",
      "destination": "/events",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/halloween/quiz",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/halloween/quiz/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/spa-shell.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/halloween/2027",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/halloween/2027/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=:path*"
    },
    {
      "source": "/halloween/quiz",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/halloween/quiz/:path*",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/halloween/2027",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/halloween/2027/:path*",
      "destination": "/spa-shell.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/retry",
      "schedule": "0 5 * * *"
    }
  ]
}
